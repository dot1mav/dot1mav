##############################################
#  GENERAL SETTINGS
##############################################

# Turn on debug? (1/0, true/false, yes/no)
DEBUG=1

# Allowed hosts (comma-separated, no spaces required)
# Example: ALLOWED_HOSTS=example.com,api.example.com,192.168.1.10
ALLOWED_HOSTS=

# CORS allowed origins (comma-separated)
# Example: CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

##############################################
#  DATABASE CONFIGURATION
##############################################

DB_ENGINE=mysql

MYSQL_DATABASE=portfolio
MYSQL_USER=root
MYSQL_PASSWORD=amin1398
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CNF_PATH=


STATIC_URL=/static/
MEDIA_URL=/media/
